class Solution {
    public void generate(int[] candidates, int n, int target, List<List<Integer>> res, int i, int sum, List<Integer> current){
        if (sum == target) {
            res.add(new ArrayList<>(current));
            return;
        }
        if (i == n || sum > target) return;

        current.add(candidates[i]);
        // sum += candidates[i];
        generate(candidates, n, target, res, i, sum+candidates[i], current);
        current.remove(current.size()-1);
        // sum -= candidates[i];
        generate(candidates, n, target, res, i+1, sum, current);

    }
    public List<List<Integer>> combinationSum(int[] candidates, int target) {
        List<List<Integer>> res = new ArrayList<>();
        int n = candidates.length;
        generate(candidates, n, target, res, 0, 0, new ArrayList<>());
        return res;
    }
}
