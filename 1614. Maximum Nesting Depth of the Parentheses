class Solution {
    public int maxDepth(String s) {

        int n = s.length();
        if(n == 0 || n == 1) return 0;
        int count = 0;
        int max = 0;
        for(char c: s.toCharArray()){
            if(c == '('){
                count++;
                max = Math.max(max, count);
            }
            else if(c == ')'){
                count--;
            }
        }
        return max;
    }
}
