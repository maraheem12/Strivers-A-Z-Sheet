public class Solution {
    public ArrayList<Integer> prevSmaller(ArrayList<Integer> A) {
        Stack<Integer> s = new Stack<>();
        int n = A.size();
        ArrayList<Integer> res = new ArrayList<>();
        
        for(int num: A){
            
            while(!s.isEmpty() && s.peek() >= num){
                s.pop();
            }
            res.add((s.isEmpty())? -1: s.peek());
            s.push(num);
        }
        return res;
    }
}
