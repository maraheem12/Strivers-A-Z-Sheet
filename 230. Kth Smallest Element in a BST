class Solution {
    int count=0;
    int r=0;
    public void inorder(TreeNode root, int k) {
        if(root == null){
            return;
        }
        inorder(root.left,k);
        count++;
        if(count == k){
            r = root.val;
            return;
        }
        inorder(root.right,k);

    }
    public int kthSmallest(TreeNode root, int k) {
        inorder(root,k);
        return r;
    }
}
