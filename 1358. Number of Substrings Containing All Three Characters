class Solution {
    public int numberOfSubstrings(String s) {
        int n = s.length();

        int count = 0;
        int lastseen[] = new int[26];
        Arrays.fill(lastseen, -1);

        for(int i=0; i<n; i++){
            lastseen[s.charAt(i)-'a'] = i;
            if(lastseen['a'-'a'] != -1 && lastseen['b'-'a'] != -1 && lastseen['c'-'a'] != -1){
                count += 1 + Math.min(lastseen['b'-'a'], Math.min(lastseen['c'-'a'], lastseen['a'-'a']));
            }
        }
        return count;
    }
}
