class Solution {
    
    public int maxScore(int[] cardPoints, int k) {
        int n = cardPoints.length;
        int j=n-1;
        int leftSum=0, rightSum=0, max=0;
        for(int i=0; i<k; i++){
            leftSum += cardPoints[i];
        }
        max = leftSum;
        for(int i=k-1; i>=0; i--){
            leftSum -= cardPoints[i];
            rightSum += cardPoints[j--];
            max = Math.max(max, leftSum+rightSum);
        }
        return max;
    }
}
