class Solution {
    public int jump(int[] nums) {
        int n = nums.length;
        if(n==0 || n==1) return 0;

        int r=0, jumps=0;
        int l=0;
        int far = 0;
        //r = nums[0];
        while(r<n-1){
            far=0;
            for(int i=l; i<=r; i++){
                far = Math.max(far, i+nums[i]);
            }
            l = r+1;
            r = far;
            jumps++;
        }
        return jumps;
    }
}
