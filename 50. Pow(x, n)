class Solution {
    public double myPow(double x, int n) {
        double ans = 1.0;
        boolean flag = false;
        long nn = n;
        if(nn < 0){
            flag = true;
            nn = -nn;
        }

        while(nn>0){
            if(nn%2 == 1){
                ans = ans * x;
                nn = nn-1;
            }
            else{
                x = x*x;
                nn = nn/2;
            }
        }
        if(flag){
            ans = (double)1.0/(double)ans;
        }
        return ans;
    }
}
