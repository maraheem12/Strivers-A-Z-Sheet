class Solution {
    public int longestOnes(int[] nums, int k) {
        int n = nums.length;

        int l=0, r=0, zeros=0, max = 0;

        while(r<n){
            if(nums[r] == 0){
                zeros++;
            }
            if(zeros <= k){
                max = Math.max(max, r-l+1);
            }
            else{
                if(nums[l] == 0) zeros--;
                l++;
            }
            r++;
        }
        return max;
    }
}
